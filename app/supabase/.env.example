# supabase/.env にコピーして使う（.env は Git に入れない）
# `npx supabase start` が config.toml の env(...) に、`npm run functions` が通知を送る関数に読み込む
# 本番は `npx supabase secrets set` で同じ名前を登録する

# pg_cron からの呼び出しを確かめる秘密。DB の Vault の cron_secret と同じ値にする
CRON_SECRET=local-cron-secret

# メール送信（Resend の SMTP）。ログインのメールと通知のメールの両方で使う
# SMTP_PASS は Resend の API キー（https://resend.com/api-keys）
# ドメインを認証するまでは、送信元は onboarding@resend.dev、宛先は Resend に登録したアドレスだけ
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM=LocalEC <onboarding@resend.dev>

# Expo の送信 API のアクセストークン（EAS で「Enhanced Security」を有効にしたときだけ必要）
# EXPO_ACCESS_TOKEN=
