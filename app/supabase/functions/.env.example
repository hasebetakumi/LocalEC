# supabase/functions/.env にコピーして使う（.env は Git に入れない）
# ローカルの `npx supabase functions serve` が読む。本番は `npx supabase secrets set` で同じ名前を登録する

# pg_cron からの呼び出しを確かめる秘密。DB の Vault の cron_secret と同じ値にする
CRON_SECRET=local-cron-secret

# メール送信（SMTP）。ローカルは Mailpit（config.toml の [local_smtp] smtp_port）
SMTP_HOST=host.docker.internal
SMTP_PORT=58325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LocalEC <no-reply@localec.example>

# Expo の送信 API のアクセストークン（EAS で「Enhanced Security」を有効にしたときだけ必要）
# EXPO_ACCESS_TOKEN=
